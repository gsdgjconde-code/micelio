# Copia este archivo a .env y rellena la clave.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo (opcional). Por defecto claude-opus-5-5.
# CLAUDE_MODEL=claude-opus-5-5

# Puerto del servidor (opcional)
# PORT=3000

# Clave de acceso para la app (opcional, recomendable si publicas el servidor en internet).
# APP_TOKEN=una-clave-larga

# Modo demo: devuelve un resultado de ejemplo sin llamar a la API (para probar la interfaz).
# DEMO=1

# HTTPS (necesario en el móvil para el GPS y para instalar la app). Rutas a la clave y el certificado.
# TLS_KEY=certs/clave.pem
# TLS_CERT=certs/certificado.pem
